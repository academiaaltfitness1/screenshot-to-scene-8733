# Supabase project URL and publishable/anon key (never use service_role here)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Dedicated Supabase user with access to the "catraca" module (admin also works)
AGENT_EMAIL=agent@your-gym.example
AGENT_PASSWORD=CHANGE_ME

# Henry Primme Acesso SF — values from ALT FITNESS PRD
HENRY_HOST=192.168.0.229
HENRY_PORT=3000
